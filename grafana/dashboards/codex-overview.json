      "id": 1,
      "type": "timeseries",
      "title": "Events per minute",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "codex-sqlite"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {},
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT strftime('%Y-%m-%dT%H:%M:00Z', timestamp) AS time, COUNT(*) AS count FROM events WHERE timestamp > datetime('now', '-1 hour') GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {

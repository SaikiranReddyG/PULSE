      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT severity, COUNT(*) AS count FROM events WHERE timestamp > datetime('now', '-1 hour') GROUP BY severity"

Screen {
    background: #1a1a1a;
    color: #e8e8e8;
}

Header {
    background: #222222;
    color: #e8e8e8;
}

Footer {
    background: #222222;
    color: #888888;
}

TabbedContent {
    background: #1a1a1a;
}

Tabs {
    background: #222222;
}

Tab {
    color: #888888;
}

Tab:hover {
    color: #e8e8e8;
}

Tab.-active {
    color: #5fafd7;
    background: #1a1a1a;
}

TabPane {
    height: 1fr;
}

OverviewScreen,
SyswatchScreen,
SentinelScreen,
NetlabScreen {
    height: 1fr;
}

.panel {
    border: round #333333;
    padding: 1 2;
    margin: 1;
}

.panel-title {
    color: #5fafd7;
    text-style: bold;
}

.text-muted {
    color: #888888;
}

DataTable {
    background: #1a1a1a;
}

DataTable > .datatable--header {
    background: #222222;
    color: #5fafd7;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #2a2a2a;
}

#status-bar {
    background: #222222;
    color: #888888;
    padding: 0 1;
    height: 1;
}

#status-bar .ok {
    color: #87af5f;
}

#status-bar .warn {
    color: #d7af5f;
}

#status-bar .err {
    color: #d75f5f;
}

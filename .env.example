# ============================================================================
# codex-platform — environment configuration
# Copy to .env and edit before running `make up`.
# ============================================================================

# ---- Receiver service ----
# Bind address inside the container. Leave as 0.0.0.0 (container-internal).
# The compose file maps host 127.0.0.1:8765 to this container port.
CODEX_RECEIVER_BIND=0.0.0.0
CODEX_RECEIVER_PORT=8765

# Path to SQLite database (inside the receiver and grafana containers)
CODEX_SQLITE_DB=/data/codex.db

# ---- Redis ----
CODEX_REDIS_PORT=6379
CODEX_REDIS_PASS=changeme-redis-password

# ---- Optional: Discord alerting ----
# Leave empty to disable Discord alerts entirely.
DISCORD_WEBHOOK_URL=

# ---- Optional: n8n ----
# Set to 1 to include the n8n profile in `make up`. Default: disabled.
CODEX_ENABLE_N8N=0
CODEX_N8N_PORT=5678

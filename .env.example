# ============================================================================
# pulse-platform — environment configuration
# Copy to .env and edit before running `make up`.
# ============================================================================

# ---- Receiver service ----
# Bind address inside the container. Leave as 0.0.0.0 (container-internal).
# The compose file maps host 127.0.0.1:8765 to this container port.
PULSE_RECEIVER_BIND=0.0.0.0
PULSE_RECEIVER_PORT=8765

# Retention window for old SQLite events, in days.
# Set to 0 to disable retention.
PULSE_RETENTION_DAYS=30

# Bearer token for POST /events endpoint authentication.
# If not set or empty, the endpoint rejects all requests with 401.
# Include in requests as: Authorization: Bearer <token>
PULSE_RECEIVER_TOKEN=changeme-receiver-token

# Path to SQLite database (inside the receiver and grafana containers)
PULSE_SQLITE_DB=/data/pulse.db

# ---- Redis ----
PULSE_REDIS_PORT=6379
PULSE_REDIS_PASS=changeme-redis-password

# ---- Optional: Discord alerting ----
# Leave empty to disable Discord alerts entirely.
DISCORD_WEBHOOK_URL=

# ---- Workers Discord webhook ----
PULSE_DISCORD_WEBHOOK=changeme-discord-webhook-url

 
